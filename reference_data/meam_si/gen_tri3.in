# Regenerate meam_tri3.energy + meam_tri3.forces — the partial-screening (0<S<1) cluster, the
# SOLE witness of the MEAM screening DERIVATIVE (atom-3 force is pure ∂S/∂x_k). Place library.meam
# + Si.meam in the CWD.  Run: lmp -in gen_tri3.in
units metal
atom_style atomic
boundary f f f
read_data meam_tri3.data
pair_style meam
pair_coeff * * library.meam Si Si.meam Si
run 0
variable pe equal pe
print "MEAM_TRI_PE ${pe}"
dump d all custom 1 meam_tri3.dump id fx fy fz
dump_modify d format float %.16e sort id
run 0
