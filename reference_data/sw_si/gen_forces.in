# SW forces golden — regenerate sw_si_64.forces (pair_style sw run 0).
# Prereqs (place in CWD): sw_si_64.data (committed here; generated by
#   tools/sw_lammps_check.cpp = gen::make_diamond_si(2,2,2,5.431,0.20,seed=12345)),
#   and Si.sw (the canonical LAMMPS potential, lammps/potentials/Si.sw).
# Run:  lmp -in gen_forces.in   →  sw_si_64.dump (id fx fy fz, %.16e, sorted).
# Then prepend "PE <pe>" (from `variable p equal pe; print "$p"`) to make .forces.
units metal
atom_style atomic
boundary p p p
read_data sw_si_64.data
pair_style sw
pair_coeff * * Si.sw Si
thermo_style custom pe
run 0
variable p equal pe
print "GOLDEN_PE ${p}"
dump d all custom 1 sw_si_64.dump id fx fy fz
dump_modify d format float %.16e sort id
run 0
