# M6 PR-E2 — frozen EAM reference: perturbed FCC-Al, eam/alloy Al_zhou, run 0.
# Box = 6*4.05 = 24.3 Å > 2*cutoff(10.1025)=20.205 ⇒ single min-image is EXACT
# (matches tdmd PairGeom). Displaced so forces are nonzero (non-vacuous check).
units        metal
atom_style   atomic
boundary     p p p
lattice      fcc 4.05
region       box block 0 6 0 6 0 6
create_box   1 box
create_atoms 1 box
mass         1 26.98
displace_atoms all random 0.12 0.12 0.12 12345 units box
pair_style   eam/alloy
pair_coeff   * * reference_data/eam_al/Al_zhou.eam.alloy Al
write_data   reference_data/eam_al/eam_al_864.data nocoeff
variable     petot equal pe
dump         d all custom 1 reference_data/eam_al/eam_al_864.forces id x y z fx fy fz
dump_modify  d format line "%d %.16e %.16e %.16e %.16e %.16e %.16e" sort id
run          0
print        "${petot}" file reference_data/eam_al/eam_al_864.pe screen no
