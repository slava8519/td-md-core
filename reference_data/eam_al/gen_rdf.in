# M6 PR-E7 — frozen EAM RDF reference: FCC-Al, eam/alloy Al_zhou, NVE @ ~300K.
# Writes the equilibrated config (positions+velocities) + the averaged g(r).
units        metal
atom_style   atomic
boundary     p p p
lattice      fcc 4.05
region       box block 0 6 0 6 0 6
create_box   1 box
create_atoms 1 box
mass         1 26.98
pair_style   eam/alloy
pair_coeff   * * reference_data/eam_al/Al_zhou.eam.alloy Al
velocity     all create 300.0 12345 mom yes rot yes dist gaussian
fix          1 all nve
thermo       200
run          1000                              # equilibrate (NVE)
write_data   reference_data/eam_al/eam_rdf_864.data nocoeff
compute      myrdf all rdf 100 cutoff 6.0
fix          2 all ave/time 10 50 500 c_myrdf[*] file reference_data/eam_al/eam_rdf_864.gr mode vector
run          500                               # accumulate g(r)
